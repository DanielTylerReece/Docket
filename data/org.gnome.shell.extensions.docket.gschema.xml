<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.docket"
        path="/org/gnome/shell/extensions/docket/">
    <key name="last-active" type="s">
      <default>""</default>
    </key>
    <key name="merge-task-lists" type="b">
      <default>false</default>
    </key>
    <key name="group-past-tasks" type="b">
      <default>true</default>
    </key>
    <key name="hide-header-for-singular-task-lists" type="b">
      <default>false</default>
    </key>
    <key name="hide-empty-completed-task-lists" type="b">
      <default>false</default>
    </key>
    <key name="hide-completed-tasks" type="i">
      <default>1</default>
    </key>
    <key name="hct-apotac-unit" type="i">
      <default>1</default>
    </key>
    <key name="hct-apotac-value" type="i">
      <default>1</default>
    </key>
    <key name="hct-astod-hour" type="i">
      <default>23</default>
    </key>
    <key name="hct-astod-minute" type="i">
      <default>59</default>
    </key>
    <key name="task-list-order" type="as">
      <default>[]</default>
    </key>
    <key name="disabled-task-lists" type="as">
      <default>[]</default>
    </key>
    <key name="show-only-selected-categories" type="b">
      <default>false</default>
    </key>
    <key name="selected-task-categories" type="as">
      <default>[]</default>
    </key>
    <key name="sync-interval-minutes" type="i">
      <default>5</default>
      <summary>Background sync interval in minutes</summary>
    </key>
    <key name="delta-tokens" type="s">
      <default>""</default>
      <summary>JSON-encoded delta tokens per task list</summary>
    </key>
    <key name="task-cache" type="s">
      <default>""</default>
      <summary>JSON-encoded task cache for cold start</summary>
    </key>
    <key name="auth-event" type="s">
      <default>""</default>
      <summary>Timestamp written by prefs on sign-in/sign-out to trigger extension reload</summary>
    </key>
  </schema>
</schemalist>
